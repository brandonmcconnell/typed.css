{
  "name": "@typed-css/less",
  "version": "0.0.0",
  "description": "Less plugin for Typed.css typewriter animations, powered by @typed-css/core.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./plugin.cjs"
    }
  },
  "files": [
    "dist",
    "plugin.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@typed-css/core": "0.0.0"
  },
  "peerDependencies": {
    "less": ">=3.5.0"
  },
  "devDependencies": {
    "@types/less": "^3.0.8",
    "less": "^4.4.2"
  },
  "main": "./plugin.cjs"
}
