{
  "name": "typed-css-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build && npm test --workspaces --if-present",
    "dev": "npm run build -w @typed-css/core && npm run dev -w @typed-css/website"
  },
  "devDependencies": {
    "@types/color-name": "^2.0.0",
    "@types/node": "^22.19.1",
    "color-name": "^2.1.1",
    "postcss": "^8.5.32",
    "typescript": "^5.9.3"
  }
}
